POST http://localhost:9000
Content-Type: application/json
version: 1
tallyrequest: Export
type: Collection
id: KSReceiptDateFilterTest

{
  "static_variables": [
    { "name": "svExportFormat", "value": "jsonex" },
    { "name": "svCurrentCompany", "value": "mani9" },
    { "name": "svFromDate", "value": "20260401" },
    { "name": "svToDate", "value": "20260401" }
  ],
  "tdlmessage": [
    {
      "definitions": [
        {
          "metadata": {
            "name": "KSReceiptDateFilterTest",
            "type": "Collection",
            "ismodify": false
          },
          "attributes": [
            { "Type": "Vouchers:VoucherType" },
            { "ChildOf": "$$VchTypeReceipt" },
            { "Fetch": "Date" },
            { "Fetch": "VoucherNumber" },
            { "Fetch": "PartyLedgerName" },
            { "Fetch": "Amount" },
            { "Filter": "KSReceiptDateRange" }
          ]
        },
        {
          "metadata": {
            "name": "KSReceiptDateRange",
            "type": "System: Formula",
            "ismodify": false
          },
          "attributes": [
            { "Formula": "$Date >= ##SVFromDate AND $Date <= ##SVToDate" }
          ]
        }
      ]
    }
  ]
}
