POST http://localhost:9000
Content-Type: application/json
version: 1
tallyrequest: Export
type: Collection
id: Receipts

{
  "static_variables": [
    {
      "name": "svExportFormat",
      "value": "jsonex"
    }
  ],
  "fetch_list": [],
  "tdlmessage": [
    {
      "definitions": [
        {
          "metadata": {
            "name": "Receipts",
            "type": "Collection",
            "ismodify": false
          },
          "attributes": [
            {
              "Source Collection": "KSReceiptVoucherSource"
            },
            {
              "Walk": "AllLedgerEntries"
            },
            {
              "By": "Date: $..Date"
            },
            {
              "By": "VoucherNumber: $..VoucherNumber"
            }
          ]
        },
        {
          "metadata": {
            "name": "KSReceiptVoucherSource",
            "type": "Collection",
            "ismodify": false
          },
          "attributes": [
            {
              "Type": "Vouchers:VoucherType"
            },
            {
              "ChildOf": "$$VchTypeReceipt"
            },
            {
              "Fetch": "Date"
            },
            {
              "Fetch": "VoucherNumber"
            }
          ]
        }
      ]
    }
  ]
}