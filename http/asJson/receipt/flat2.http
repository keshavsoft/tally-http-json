
POST http://localhost:9000
Content-Type: application/json
version: 1
tallyrequest: Export
type: Collection
id: KSReceiptLedgerEntryProbe

{
  "static_variables": [
    {
      "name": "svExportFormat",
      "value": "jsonex"
    },
    {
      "name": "svCurrentCompany",
      "value": "mani9"
    }
  ],
  "tdlmessage": [
    {
      "definitions": [
        {
          "metadata": {
            "name": "KSReceiptLedgerEntryProbe",
            "type": "Collection",
            "ismodify": false
          },
          "attributes": [
            {
              "Source Collection": "KSReceiptVoucherSource"
            },
            {
              "Walk": "AllLedgerEntries"
            },
            {
              "Fetch": "LedgerName"
            },
            {
              "Fetch": "Amount"
            },
            {
              "Fetch": "IsDeemedPositive"
            },
            {
              "Compute": "ParentVoucherNumber: $$LoopCollObj:$VoucherNumber"
            },
            {
              "Compute": "ParentVoucherDate: $$LoopCollObj:$Date"
            }
          ]
        },
        {
          "metadata": {
            "name": "KSReceiptVoucherSource",
            "type": "Collection",
            "ismodify": false
          },
          "attributes": [
            {
              "Type": "Vouchers:VoucherType"
            },
            {
              "ChildOf": "$$VchTypeReceipt"
            },
            {
              "Fetch": "Date"
            },
            {
              "Fetch": "VoucherNumber"
            }
          ]
        }
      ]
    }
  ]
}
