POST http://localhost:9000
Content-Type: application/json
version: 1
tallyrequest: Export
type: Collection
id: KSReceiptVoucherSource

{
  "static_variables": [
    {
      "name": "svExportFormat",
      "value": "jsonex"
    },
    {
      "name": "svCurrentCompany",
      "value": "mani9"
    }
  ],
  "tdlmessage": [
    {
      "definitions": [
        {
          "metadata": {
            "name": "KSReceiptVoucherSource",
            "type": "Collection",
            "ismodify": false
          },
       "attributes": [
  {
    "Type": "Vouchers:VoucherType"
  },
  {
    "Child Of": "$$VchTypeReceipt"
  },
  {
    "Fetch": "Date, VoucherNumber"
  },
  {
    "Filter": "KSReceiptVoucherNumberIsOne"
  }
]
        },
        {
          "metadata": {
            "name": "KSReceiptVoucherNumberIsOne",
            "type": "System: Formula",
            "ismodify": false
          },
          "attributes": [
            {
              "Formula": "$VoucherNumber = \"1\""
            }
          ]
        }
      ]
    }
  ]
}