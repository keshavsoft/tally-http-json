
POST http://localhost:9000
Content-Type: text/xml

<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>Export</TALLYREQUEST>
    <TYPE>Collection</TYPE>
    <ID>KSFilteredLedgers</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
        <SVCURRENTCOMPANY>mani9</SVCURRENTCOMPANY>
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>
          <COLLECTION NAME="KSFilteredLedgers"
                      ISMODIFY="No"
                      ISFIXED="No"
                      ISINITIALIZE="No"
                      ISOPTION="No"
                      ISINTERNAL="No">
            <TYPE>Ledger</TYPE>
            <FILTER>KSNameFilter</FILTER>
            <NATIVEMETHOD>Name</NATIVEMETHOD>
          </COLLECTION>
          <SYSTEM TYPE="Formulae"
                  NAME="KSNameFilter"
                  ISMODIFY="No"
                  ISFIXED="No"
                  ISINTERNAL="No">$Name contains "KS JSON"</SYSTEM>
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>
